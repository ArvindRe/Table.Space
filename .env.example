# ZFS Replication credentials — copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Base64-encoded "user:password" for the ZFS REST API
ZFS_AUTH_HEADER=

# Full URL to the replication action endpoint
# e.g. https://<zfs-host>:<port>/api/storage/v1/replication/actions/<action-uuid>
ZFS_ACTION_URL=
